private static void task4() {

        Random rand = new Random();
        int secret = rand.nextInt(100) + 1;

        if (secret < 1 || secret > 100) {
            throw new IllegalStateException("Generated number out of range");
        }

        int attempts = 0;
        int guess;

        System.out.println("Task 4:");

        do {
            guess = rand.nextInt(100) + 1;

            if (guess < 1 || guess > 100) {
                throw new IllegalStateException("Guess out of range");
            }

            attempts++;

            if (guess > secret)
                System.out.println(guess + " -> Too high");
            else if (guess < secret)
                System.out.println(guess + " -> Too low");
            else
                System.out.println(guess + " -> Correct!");

        } while (guess != secret);

        System.out.println("Attempts needed: " + attempts);
        System.out.println();
    }
Zad 5 
private static void task5() {

        String text = "Hello World 123";

        if (text == null) {
            throw new IllegalArgumentException("Text cannot be null");
        }

        int upper = 0;
        int lower = 0;
        boolean onlyLetters = true;

        for (char c : text.toCharArray()) {

            if (Character.isUpperCase(c)) upper++;
            if (Character.isLowerCase(c)) lower++;

            if (c != ' ' && !Character.isLetter(c)) {
                onlyLetters = false;
            }
        }

        String replaced = text.replaceAll("[0-9]", "#");

        System.out.println("Task 5:");
        System.out.println("Uppercase letters: " + upper);
        System.out.println("Lowercase letters: " + lower);
        System.out.println("Only letters (ignoring spaces): " + onlyLetters);
        System.out.println("After replacing numbers: " + replaced);
    }
}
